    {"id":"micro","op":"fbm_3d","inputs":["x","y","z","micro_size"],"seed":1109,"octaves":3,"lacunarity":2.17,"persistence":0.48},
    {"id":"cell","op":"cellular_f1_3d","inputs":["x","y","z","cell_size"],"seed":1117},
