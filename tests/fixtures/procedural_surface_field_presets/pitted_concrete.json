    {"id":"pit_dark_amp","op":"constant","value":0.17},
    {"id":"pit_dark","op":"multiply","inputs":["cavity","pit_dark_amp"]},
    {"id":"base_r","op":"constant","value":0.49},
    {"id":"base_g","op":"constant","value":0.475},
    {"id":"base_b","op":"constant","value":0.445},
