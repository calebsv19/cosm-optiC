{
  "schema":"ray_tracing.procedural_surface_field_graph",
  "schema_version":1,
  "program_id":"central_mountain_peak_v1",
  "max_node_evaluations":96,
  "nodes":[
    {"id":"x","op":"position_x"},
    {"id":"y","op":"position_y"},
    {"id":"z","op":"position_z"},
    {"id":"one","op":"constant","value":1.0},
    {"id":"zero","op":"constant","value":0.0},
    {"id":"radius","op":"length2","inputs":["x","y"]},
    {"id":"peak_inner","op":"constant","value":0.18},
    {"id":"peak_outer","op":"constant","value":4.7},
    {"id":"radial_rise","op":"smoothstep","inputs":["peak_inner","peak_outer","radius"]},
    {"id":"falloff","op":"subtract","inputs":["one","radial_rise"]},
    {"id":"warp_size","op":"constant","value":2.4},
    {"id":"warp","op":"fbm_3d","inputs":["x","y","z","warp_size"],"seed":4111,"octaves":5,"lacunarity":2.03,"persistence":0.53},
    {"id":"ridge_size","op":"constant","value":1.05},
    {"id":"ridge","op":"ridged_fbm_3d","inputs":["x","y","z","ridge_size"],"seed":4127,"octaves":6,"lacunarity":2.11,"persistence":0.54},
    {"id":"detail_size","op":"constant","value":0.31},
    {"id":"detail","op":"fbm_3d","inputs":["x","y","z","detail_size"],"seed":4139,"octaves":4,"lacunarity":2.17,"persistence":0.49},
    {"id":"base_peak","op":"constant","value":0.68},
    {"id":"ridge_amp","op":"constant","value":0.31},
    {"id":"warp_amp","op":"constant","value":0.12},
    {"id":"detail_amp","op":"constant","value":0.075},
    {"id":"ridge_height","op":"multiply","inputs":["ridge","ridge_amp"]},
    {"id":"warp_height","op":"multiply","inputs":["warp","warp_amp"]},
    {"id":"detail_height","op":"multiply","inputs":["detail","detail_amp"]},
    {"id":"peak_ridge","op":"add","inputs":["base_peak","ridge_height"]},
    {"id":"peak_warp","op":"add","inputs":["peak_ridge","warp_height"]},
    {"id":"peak_detail","op":"add","inputs":["peak_warp","detail_height"]},
    {"id":"height_raw","op":"multiply","inputs":["falloff","peak_detail"]},
    {"id":"height_nonnegative","op":"maximum","inputs":["height_raw","zero"]},
    {"id":"height","op":"minimum","inputs":["height_nonnegative","one"]},
    {"id":"abs_detail","op":"absolute","inputs":["detail"]},
    {"id":"cavity_amp","op":"constant","value":0.7},
    {"id":"cavity","op":"multiply","inputs":["abs_detail","cavity_amp"]},
    {"id":"rock_low","op":"constant","value":0.28},
    {"id":"rock_high","op":"constant","value":0.62},
    {"id":"rockiness","op":"smoothstep","inputs":["rock_low","rock_high","height"]},
    {"id":"snow_low","op":"constant","value":0.66},
    {"id":"snow_high","op":"constant","value":0.84},
    {"id":"snow","op":"smoothstep","inputs":["snow_low","snow_high","height"]},
    {"id":"green_r","op":"constant","value":0.20},
    {"id":"green_g","op":"constant","value":0.285},
    {"id":"green_b","op":"constant","value":0.145},
    {"id":"rock_r","op":"constant","value":0.40},
    {"id":"rock_g","op":"constant","value":0.355},
    {"id":"rock_b","op":"constant","value":0.31},
    {"id":"snow_r","op":"constant","value":0.90},
    {"id":"snow_g","op":"constant","value":0.92},
    {"id":"snow_b","op":"constant","value":0.96},
    {"id":"ground_rock_r","op":"mix","inputs":["green_r","rock_r","rockiness"]},
    {"id":"ground_rock_g","op":"mix","inputs":["green_g","rock_g","rockiness"]},
    {"id":"ground_rock_b","op":"mix","inputs":["green_b","rock_b","rockiness"]},
    {"id":"color_r","op":"mix","inputs":["ground_rock_r","snow_r","snow"]},
    {"id":"color_g","op":"mix","inputs":["ground_rock_g","snow_g","snow"]},
    {"id":"color_b","op":"mix","inputs":["ground_rock_b","snow_b","snow"]},
    {"id":"ground_rough","op":"constant","value":0.79},
    {"id":"rock_rough","op":"constant","value":0.67},
    {"id":"snow_rough","op":"constant","value":0.72},
    {"id":"ground_rock_rough","op":"mix","inputs":["ground_rough","rock_rough","rockiness"]},
    {"id":"roughness","op":"mix","inputs":["ground_rock_rough","snow_rough","snow"]}
  ],
  "outputs":{"height":"height","macro":"warp","micro":"detail","cavity":"cavity","mask":"snow","color_r":"color_r","color_g":"color_g","color_b":"color_b","roughness":"roughness"}
}
