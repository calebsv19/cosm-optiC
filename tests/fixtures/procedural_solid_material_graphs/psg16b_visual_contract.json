{
  "schema": "ray_tracing.procedural_solid_psg16b_visual_contract",
  "schema_version": 1,
  "proof_id": "procedural_solid_material_graphs_psg16b",
  "title": "PSG-16B deterministic weighted procedural texture layers",
  "visual_intent": "Prove bounded authored-material mask composition on newly authored family-appropriate geometry, continuous native-hit geometry inputs, and deterministic graph-order procedural texture layers whose effective opacity follows graph weight without a threshold switch.",
  "expected_visual_signal": "Snow follows the elevated upward-facing terrain body, pore coloration breaks up a newly authored simple solid without changing its silhouette, sediment settles into the tunnel family, dune bands follow a newly authored top-bound sand terrain, and strata read as height-oriented layers on a newly authored tall rock form. A dedicated mountain strip must progress smoothly through texture weights 0.49, 0.50, and 0.51 with no material identity switch and exact repeat determinism.",
  "rejection_condition": "Reject if semantic families silently reuse one universal shell, if the snow subject is a sphere union, if dunes are shown only on the tunnel block, if any mask debug view is flat or missing, if the mountain raw views exceed the shared-edge continuity bound, if either neighboring texture-weight step is absent or disproportionately large, if the repeated 0.50 render differs, if material variants change geometry identity, or if the proof claims physical pores, bump normals, or material-driven displacement.",
  "base_recipe": "tests/fixtures/procedural_surface_rock_prism_psg0/recipe.json",
  "source_passthrough_graph": "tests/fixtures/procedural_solid_graphs/source_mesh_passthrough.json",
  "render": {
    "width": 800,
    "height": 600,
    "temporal_frames": 8,
    "integrator_3d": "disney_v2",
    "camera_zoom": 1.08
  },
  "lighting": {
    "environment_light_mode": "ambient",
    "ambient_strength": 0.42,
    "top_fill_strength": 1.25,
    "light_intensity": 4.0,
    "light_radius": 0.15
  },
  "assertions": {
    "minimum_primary_hit_pixels": 1800,
    "minimum_image_luma_standard_deviation": 5.0,
    "minimum_mask_luma_standard_deviation": 3.0,
    "minimum_subtle_to_strong_changed_pixels": 700,
    "minimum_mask_changed_pixels_from_balanced_beauty": 700
  },
  "weighted_transition": {
    "family": "mountain_snow",
    "node": "snow_mask",
    "weights": [0.0, 0.49, 0.5, 0.51, 1.0],
    "minimum_neighbor_changed_pixels": 100,
    "maximum_neighbor_step_fraction_of_endpoint": 0.08,
    "maximum_neighbor_step_ratio": 1.5
  },
